# ── LLM providers (all free tier — add at least one) ─────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434    # optional local models (uses G15 GPU, zero tokens)

# ── Voice ────────────────────────────────────────────────────────
WAKE_WORD=cryous
TTS_VOICE=en-GB-GeorgeNeural           # Jarvis-style. Try en-US-GuyNeural, en-GB-SoniaNeural
TTS_ENABLED=1
GREET_ON_BOOT=1
SPEAK_UI=1                             # speak replies to typed chat too
BARGE_IN=0                             # interrupt TTS when you start talking
VOSK_MODEL=vosk-model-small-en-us-0.15

# ── System ───────────────────────────────────────────────────────
UI_PORT=8123
WEEKLY_TOKEN_BUDGET=1500000000         # 1.5B soft weekly cap across all providers
MAX_HISTORY=8                          # turns kept verbatim; older turns get compressed
USER_NAME=boss

# ── Email (optional) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=